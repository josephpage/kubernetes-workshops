# Généré par OpenTofu (terraform/${cloud}) — NE PAS COMMITER : contient des secrets.
# Contrat commun aux 4 clouds : les scripts de l'atelier ne lisent que ces variables.
# Usage : source demos/ax/workshop.env

# --- Cluster ---------------------------------------------------------------
export AX_CLOUD="${cloud}"
export CLUSTER_NAME="${cluster_name}"
export KUBECONFIG="${kubeconfig}"

# --- Images ----------------------------------------------------------------
# Préfixe des images du plan de contrôle (Substrate, AX) construites avec ko.
export IMAGE_REPO="${image_repo}"
# Dépôt de l'image des sandboxes (ax-agent-runner). Elle est tirée par atelet,
# pas par le kubelet : en Substrate v0.3.0, atelet ne sait s'authentifier
# qu'auprès des registres GCP, ce dépôt doit donc être lisible anonymement
# (sauf sur GKE).
export AGENT_IMAGE_REPO="${agent_image_repo}"

# --- Snapshots des sandboxes ------------------------------------------------
# gcs : backend natif (GKE + Workload Identity) ; s3 : tout stockage compatible S3.
export SNAPSHOT_BACKEND="${snapshot_backend}"
# Préfixe passé aux ActorTemplates (Substrate lit le bucket et le chemin,
# quel que soit le backend).
export SNAPSHOT_LOCATION="${snapshot_location}"
export S3_ENDPOINT="${s3_endpoint}"
export S3_REGION="${s3_region}"
export S3_FORCE_PATH_STYLE="${s3_force_path_style}"
export S3_ACCESS_KEY_ID="${s3_access_key_id}"
export S3_SECRET_ACCESS_KEY="${s3_secret_access_key}"
# true : déployer un stockage S3 dans le cluster (rustfs), faute d'API S3 chez le fournisseur.
export S3_IN_CLUSTER="${s3_in_cluster}"

# --- LLM (passerelle LiteLLM dans le cluster) --------------------------------
export LLM_PROVIDER="${llm_provider}"
export LLM_MODEL="${llm_model}"
export LLM_API_BASE="${llm_api_base}"
export LLM_API_KEY="${llm_api_key}"
export LLM_API_VERSION="${llm_api_version}"
export LLM_AWS_REGION="${llm_aws_region}"
export LLM_VERTEX_PROJECT="${llm_vertex_project}"
export LLM_VERTEX_LOCATION="${llm_vertex_location}"
# Annotation du ServiceAccount de la passerelle (identité de workload), ou vide.
export LLM_SERVICE_ACCOUNT_ANNOTATION="${llm_service_account_annotation}"
