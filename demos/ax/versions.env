# Versions épinglées de l'atelier AX — vérifiées le 2026-10-02.
# Source unique de vérité : les scripts de l'atelier lisent ce fichier.
# Avant de monter une version, relire les notes de release (AX et Substrate
# sont pré-1.0 : chaque mineure peut casser l'API ou l'installation).

# google/ax (Agent Executor) : CLI `ax`, ax-server, ax-controller, ax-task-runner.
AX_VERSION=v0.3.1

# agent-substrate/substrate : runtime de sandboxes sur lequel AX s'appuie.
# AX v0.3.1 est compilé contre une révision de Substrate antérieure à v0.3.0 ;
# v0.3.0 est la release la plus proche, validée de bout en bout par l'atelier.
SUBSTRATE_VERSION=v0.3.0

# ko : build et push des images Go (Substrate et plan de contrôle AX) sans Docker.
KO_VERSION=v0.19.1

# OpenCode : agent de code exécuté dans les sandboxes AX.
OPENCODE_VERSION=v1.18.34

# Tag de l'image des sandboxes (runner AX + OpenCode), dérivé des deux versions.
AGENT_IMAGE_TAG="${AX_VERSION}-opencode-${OPENCODE_VERSION}"

# LiteLLM : passerelle LLM compatible OpenAI déployée dans le cluster.
# Image signée cosign, épinglée par digest.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.103.2@sha256:f63fb81b831b170ec16851e23c36ac5bf52ef106b271406429524a2ed730bbfd

# Kubernetes minimal : PodCertificateRequest et ClusterTrustBundle sont GA en 1.37.
KUBERNETES_MIN_VERSION=1.37
